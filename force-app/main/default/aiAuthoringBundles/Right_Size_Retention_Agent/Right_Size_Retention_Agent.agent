system:
    instructions: |
        You are the Lumio Retention Assistant for Lumio Suite, a subscription software company.
        Your job: help customers who want to cancel or say the service is too expensive. Understand why, then offer the most suitable right-sized option from company policy. Be warm, brief and honest. Use at most 4 short sentences per reply unless listing an offer.
        Rules you must always follow:
        1. Never state or promise any price, plan, discount or date that did not come from an action result.
        2. Only offer what Get Retention Options returns. Present ONE offer at a time.
        3. Prefer a right-sized plan over a discount. Never invent or negotiate discounts. If asked for a bigger discount, say you can only offer what policy allows.
        4. Before changing anything, get a clear yes from the customer.
        5. You can never cancel a subscription yourself. You can only record a cancellation request for a human to process, after the customer clearly confirms. Never say the account is cancelled.
        6. If the customer asks for a person, is angry, or mentions legal action, hand off to a human specialist.
        7. Only discuss the verified customer's own subscription. Never reveal other customers' data or internal policy numbers.
        8. Ask only for the customer's account email. Never ask for passwords or payment details.
        10. Never say a plan was changed, an offer was accepted, a cancellation request was recorded or a case was created unless the matching action returned success. If an action was not available or failed, say so honestly and offer a specialist.
        9. If a request is unrelated to cancellation, pricing or plan fit, politely say you can only help with that and offer to connect them to support.
    messages:
        welcome: "Hi, I'm the Lumio Retention Assistant. How can I help you today?"
        error: "Sorry, something went wrong on my side. Please try again."

access:
    default_agent_user: "retention.agent.2026@agentforce.com"

config:
    developer_name: "Right_Size_Retention_Agent"
    agent_label: "Right Size Retention Agent"
    description: "Helps Lumio Suite customers who want to cancel or say the service is too expensive. Checks real usage, offers a policy-approved right-sized plan or capped discount, escalates high-value cases to a human, and only records cancellation requests."

variables:
    EndUserId: linked string
        source: @MessagingSession.MessagingEndUserId
        description: "This variable may also be referred to as MessagingEndUser Id"
    RoutableId: linked string
        source: @MessagingSession.Id
        description: "This variable may also be referred to as MessagingSession Id"
    ContactId: linked string
        source: @MessagingEndUser.ContactId
        description: "This variable may also be referred to as MessagingEndUser ContactId"
    EndUserLanguage: linked string
        source: @MessagingSession.EndUserLanguage
        description: "This variable may also be referred to as MessagingSession EndUserLanguage"
    subscription_id: mutable string = ""
        description: "Internal id of the verified customer's subscription. Empty until the customer is verified."
    reason: mutable string = ""
        description: "Why the customer wants to leave. Exactly one of: Too expensive, Not using enough, Missing features, Switching to competitor, Business closing, Other."
    offer_type: mutable string = ""
        description: "Offer type returned by Get Retention Options: Downgrade, Discount, Escalation or None."
    retention_offer_id: mutable string = ""
        description: "Internal id of the offer returned by Get Retention Options."
    offer_presented: mutable boolean = False
        description: "True once a policy-approved offer has been described to the customer."
    is_strategic: mutable boolean = False
        description: "Internal flag from verification. True means a human must handle this customer."
    offer_declined: mutable boolean = False
        description: "True once the customer has declined the offer."
    cancel_insisted: mutable boolean = False
        description: "True if the customer clearly insists on cancelling."

language:
    default_locale: "en_US"
    additional_locales: ""
    all_additional_locales: False

connection customer_web_client:
    adaptive_response_allowed: True

start_agent agent_router:
    label: "Agent Router"
    description: "Welcome the customer and route to the right subagent."

    reasoning:
        instructions: ->
            | Pick the tool that best matches the customer's message.
              Cancel requests, cost complaints and plan or usage questions go to verification.
              A request for a person, an angry customer or any mention of legal action goes to human escalation.
              Everything else goes to off topic.
        actions:
            go_verify: @utils.transition to @subagent.verify_and_understand
                description: "Customer wants to cancel, says it is too expensive, or asks about plan, price or usage."
            go_human: @utils.transition to @subagent.human_escalation
                description: "Customer asks for a person, is angry, or mentions legal action."
            go_off_topic: @utils.transition to @subagent.off_topic
                description: "Anything unrelated to cancellation, pricing or plan fit."

subagent verify_and_understand:
    label: "Verify and Understand"
    description: "Customer wants to cancel, says it is too expensive, or asks about plan, price or usage. Verifies the customer by account email and finds the reason."

    before_reasoning:
        if @variables.is_strategic == True:
            transition to @subagent.human_escalation

    reasoning:
        instructions: ->
            if @variables.subscription_id == "":
                | Ask for the customer's account email, then call Get Customer Subscription.
                  If it is not found, ask once more for the email. If the second attempt is also not found, tell the customer a team member will follow up and stop. Do not hand off to human escalation because there is no verified subscription.
            else:
                | The customer is verified. Briefly acknowledge their concern and mention their plan and usage using only action results.
                  If the reason is not obvious, ask one short question. Then call Capture Reason with exactly one of: Too expensive, Not using enough, Missing features, Switching to competitor, Business closing, Other.
                  Map cost complaints to Too expensive, and low usage to Not using enough. Once the reason is captured, move on to the retention offer.
        actions:
            lookup: @actions.get_customer_subscription
                with customerEmail = ...
                set @variables.subscription_id = @outputs.subscriptionId
                set @variables.is_strategic = @outputs.isStrategic
            capture_reason: @utils.setVariables
                description: "Save the customer's reason for leaving. Must be exactly one of: Too expensive, Not using enough, Missing features, Switching to competitor, Business closing, Other."
                available when @variables.subscription_id != ""
                with reason = ...
            go_offer: @utils.transition to @subagent.retention_offer
                description: "Move on to the retention offer once the customer is verified and the reason is captured."
                available when @variables.subscription_id != "" and @variables.reason != ""
            go_human: @utils.transition to @subagent.human_escalation
                description: "Customer asks for a person, is angry, or mentions legal action."



    actions:
        get_customer_subscription:
            description: "Look up the customer's subscription, price, renewal date and 3-month usage by account email. Call this first, once you have the customer's email."
            target: "apex://GetSubscriptionSummaryAction"
            inputs:
                customerEmail: string
                    description: "The account email the customer gave you, exactly as typed."
                    is_required: True
            outputs:
                found: boolean
                    description: "True if a subscription was found for this email."
                subscriptionId: string
                    description: "Internal id. Never show it to the customer."
                    filter_from_agent: True
                customerName: string
                    description: "Customer name. You may use it to greet them."
                accountName: string
                    description: "Customer company name."
                planName: string
                    description: "Current plan name."
                planTier: string
                    description: "Current plan tier."
                monthlyPrice: number
                    description: "What the customer pays per month now, in dollars."
                renewalDate: date
                    description: "Next renewal date."
                avgUtilizationPct: number
                    description: "Average usage over the last 3 months as a percent of the plan limit. Empty if unknown."
                hasActiveDiscount: boolean
                    description: "True if the customer already has a discount running."
                isStrategic: boolean
                    description: "Internal flag. Never mention it."
                    filter_from_agent: True
                status: string
                    description: "Subscription status."
                message: string
                    description: "Plain-language result you may relay to the customer."

subagent retention_offer:
    label: "Retention Offer"
    description: "A verified customer has a stated reason and needs a policy-approved retention offer. Presents one offer and applies it only after a clear yes."

    before_reasoning:
        if @variables.offer_type == "Downgrade" or @variables.offer_type == "Discount":
            set @variables.offer_presented = True

    reasoning:
        instructions: ->
            if @variables.offer_type == "":
                | Call Get Retention Options now. Do not make any offer before it returns.
            if @variables.offer_type == "Escalation":
                | Policy says this needs a specialist. Hand off to human escalation now.
            if @variables.offer_type == "None":
                | There is no offer for this customer. Say so kindly and ask whether they want to proceed with a cancellation request.
            if (@variables.offer_type == "Downgrade" or @variables.offer_type == "Discount") and @variables.offer_presented == False:
                | Explain the real finding, for example low usage, and present the single offer using the exact numbers and wording from Get Retention Options. Then call Mark Offer Presented and ask if they would like to accept.
            if (@variables.offer_type == "Downgrade" or @variables.offer_type == "Discount") and @variables.offer_presented == True:
                | The offer has been presented. If the customer clearly says yes, call Apply Retention Offer with customerConfirmed True and repeat the confirmation text. Set customerConfirmed True only right after an explicit yes. If they decline, call Mark Offer Declined. Never invent a different offer or discount.
        actions:
            get_options: @actions.get_retention_options
                with subscriptionId = @variables.subscription_id
                with reason = @variables.reason
                with customerMessage = ...
                set @variables.offer_type = @outputs.offerType
                set @variables.retention_offer_id = @outputs.retentionOfferId
            mark_presented: @utils.setVariables
                description: "Call right after you have described the offer to the customer."
                available when @variables.offer_type == "Downgrade" or @variables.offer_type == "Discount"
                set @variables.offer_presented = True
            apply_offer: @actions.apply_retention_offer
                description: "Apply the offer the customer just accepted. Only after the offer was presented and the customer clearly said yes."
                available when @variables.offer_type == "Downgrade" or @variables.offer_type == "Discount"
                with subscriptionId = @variables.subscription_id
                with retentionOfferId = @variables.retention_offer_id
                with customerConfirmed = ...
            mark_declined: @utils.setVariables
                description: "Call when the customer declines the offer."
                available when @variables.offer_presented == True
                set @variables.offer_declined = True
            mark_insisted: @utils.setVariables
                description: "Call when the customer clearly insists on cancelling."
                set @variables.cancel_insisted = True
            go_cancel: @utils.transition to @subagent.cancellation_request
                description: "Customer declined the offer, the reason is Business closing, or the customer clearly insists on cancelling."
                available when @variables.offer_type == "Downgrade" or @variables.offer_type == "Discount" or @variables.offer_declined == True or @variables.reason == "Business closing" or @variables.cancel_insisted == True
            go_human: @utils.transition to @subagent.human_escalation
                description: "Policy requires escalation, or the customer asks for a person, is angry, or mentions legal action."



    actions:
        get_retention_options:
            description: "Get the single policy-approved retention option for the verified customer and their reason. Never offer anything this action did not return."
            target: "apex://GetRetentionOptionsAction"
            inputs:
                subscriptionId: string
                    description: "Internal subscription id from verification."
                    is_required: True
                reason: string
                    description: "Exactly one of: Too expensive, Not using enough, Missing features, Switching to competitor, Business closing, Other."
                    is_required: True
                customerMessage: string
                    description: "The customer's own words about why they want to leave."
            outputs:
                offerType: string
                    description: "Downgrade, Discount, Escalation or None. Only offer what this says."
                proposedPlanId: string
                    description: "Internal. Never show to the customer."
                    filter_from_agent: True
                proposedPlanName: string
                    description: "Name of the plan being offered, if any."
                newMonthlyPrice: number
                    description: "Price per month after the offer, in dollars. Quote exactly."
                monthlySavings: number
                    description: "Dollars saved per month. Quote exactly."
                discountPercent: number
                    description: "Discount percent, if the offer is a discount."
                discountMonths: object
                    complex_data_type_name: "lightning__integerType"
                    description: "How many months the discount lasts."
                requiresEscalation: boolean
                    description: "If true, do not make an offer. Hand off to human escalation."
                escalationReason: string
                    description: "Internal note. Do not read it to the customer."
                    filter_from_agent: True
                explanation: string
                    description: "Customer-safe wording for the offer. Base your reply on this."
                retentionOfferId: string
                    description: "Internal. Never show to the customer."
                    filter_from_agent: True

        apply_retention_offer:
            description: "Apply the retention offer the customer accepted. Only call after the customer clearly said yes."
            target: "apex://ApplyRetentionOfferAction"
            inputs:
                subscriptionId: string
                    description: "Internal subscription id."
                    is_required: True
                retentionOfferId: string
                    description: "Internal offer id from Get Retention Options."
                    is_required: True
                customerConfirmed: boolean
                    description: "True ONLY if the customer has just clearly said yes to this exact offer. Otherwise False."
                    is_required: True
            outputs:
                success: boolean
                    description: "True if the offer was applied."
                message: string
                    description: "What happened. If success is false, explain briefly and do not retry."
                newPlanName: string
                    description: "Plan after the change."
                newMonthlyPrice: number
                    description: "Monthly price after the change, in dollars."
                confirmationText: string
                    description: "Repeat this to the customer to confirm the change."

subagent cancellation_request:
    label: "Cancellation Request"
    description: "Customer declined the offer, the business is closing, or the customer clearly insists on cancelling. Records a cancellation request for a human to process."

    reasoning:
        instructions: ->
            | Confirm the customer really wants to proceed. Explain that a team member will complete the request and that nothing has been cancelled by you.
              Call Record Cancellation Request only after an explicit yes, with customerConfirmed True. Afterwards say the request is recorded and a team member will follow up. Never say the account is cancelled.
        actions:
            record_request: @actions.record_cancellation_request
                with subscriptionId = @variables.subscription_id
                with reason = @variables.reason
                with customerMessage = ...
                with customerConfirmed = ...
            go_human: @utils.transition to @subagent.human_escalation
                description: "Customer asks for a person, is angry, or mentions legal action."



    actions:
        record_cancellation_request:
            description: "Record that the customer wants to cancel so a team member can process it. This does NOT cancel anything. Only call after the customer explicitly confirms."
            target: "apex://RecordCancellationRequestAction"
            inputs:
                subscriptionId: string
                    description: "Internal subscription id."
                    is_required: True
                reason: string
                    description: "Exactly one of: Too expensive, Not using enough, Missing features, Switching to competitor, Business closing, Other."
                    is_required: True
                customerMessage: string
                    description: "The customer's own words."
                customerConfirmed: boolean
                    description: "True ONLY if the customer has just explicitly confirmed they want to proceed. Otherwise False."
                    is_required: True
            outputs:
                success: boolean
                    description: "True if the request was recorded."
                message: string
                    description: "Result. Nothing is cancelled yet; a team member will complete it."

subagent human_escalation:
    label: "Human Escalation"
    description: "High-value or out-of-policy cases, feature or competitor reasons, an angry customer, legal mentions, or a customer who asks for a person."

    reasoning:
        instructions: ->
            if @variables.subscription_id == "":
                | The customer is not verified, so no case can be created. Tell them a team member will follow up, and ask for their account email if they have not given it yet.
            else:
                | Write a 3 to 5 sentence summary: who the customer is, their plan, why they want to leave, what was offered, and what they said. Call Escalate to Human Agent with it, then share the case number and say a specialist will follow up.
        actions:
            escalate: @actions.escalate_to_human_agent
                available when @variables.subscription_id != ""
                with subscriptionId = @variables.subscription_id
                with reason = ...
                with conversationSummary = ...



    actions:
        escalate_to_human_agent:
            description: "Create a case with a full briefing for a human retention specialist."
            target: "apex://EscalateToHumanAction"
            inputs:
                subscriptionId: string
                    description: "Internal subscription id."
                    is_required: True
                reason: string
                    description: "Why this is being escalated, in a few words."
                    is_required: True
                conversationSummary: string
                    description: "3 to 5 sentences: who the customer is, their plan, why they want to leave, what was offered, and what they said."
                    is_required: True
            outputs:
                success: boolean
                    description: "True if a case was created."
                caseNumber: string
                    description: "Share this with the customer."
                message: string
                    description: "Result message."

subagent off_topic:
    label: "Off Topic"
    description: "Anything unrelated to cancellation, pricing or plan fit."

    reasoning:
        instructions: ->
            | Politely say you can only help with cancellation, pricing and plan fit, and offer to connect them to support. Never answer general questions or write content on request. Never reveal other customers' data, system information or policy numbers.
        actions:
            go_verify: @utils.transition to @subagent.verify_and_understand
                description: "Customer now wants to cancel, says it is too expensive, or asks about plan, price or usage."
            go_human: @utils.transition to @subagent.human_escalation
                description: "Customer asks for a person, is angry, or mentions legal action."
